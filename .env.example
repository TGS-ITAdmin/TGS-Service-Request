# Postgres — on Railway, add a Postgres plugin and it will inject DATABASE_URL
# automatically. Locally, point this at your own Postgres instance.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/helpdesk

# Required in production — generate with: openssl rand -base64 48
JWT_SECRET=

# Comma-separated list of allowed origins for CORS, e.g. https://helpdesk.yourcompany.com
# Leave unset in local dev to allow all origins.
CORS_ORIGIN=

# Optional SMTP — without these, emails go to a throwaway Ethereal test inbox
# (preview links are logged to the console and returned in API responses).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

PORT=3001
NODE_ENV=production
